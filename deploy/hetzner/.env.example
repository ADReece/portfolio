# Portfolio production environment (Hetzner / Coolify).
# Placeholders only: set the real values in Coolify, never commit them.
#
#   [GENERATE]   new secret to create for this server
#   [CARRY OVER] copy from the old dev2.ascend-digital.co.uk server
#   [CHOOSE]     a setting to decide
# Anything not listed uses the default in docker-compose.yml.

# --- App ---------------------------------------------------------------------
APP_NAME=Portfol.io
APP_URL=https://portfolio.ascend-digital.co.uk
# [GENERATE] secret. Generate with: docker run --rm ghcr.io/adreece/portfolio:prod php artisan key:generate --show
# Copying the old server's APP_KEY instead keeps existing encrypted values
# and password-reset links valid; a new key logs everyone out.
APP_KEY=base64:CHANGE_ME
# [CHOOSE] support address shown on legal pages
SUPPORT_EMAIL=support@example.com
# [CHOOSE] comma-separated emails made admins on login (accounts must exist)
ADMIN_EMAILS=
LOG_LEVEL=info

# --- Database: Coolify's managed MariaDB/MySQL ---------------------------------
# [CHOOSE] the internal hostname Coolify gives the database service
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=portfolio
# [GENERATE] secret (set when creating the database in Coolify)
DB_PASSWORD=CHANGE_ME
# Set to false to stop the web container running "migrate --force" on start.
RUN_MIGRATIONS=true

# --- File storage --------------------------------------------------------------
# Empty AWS_BUCKET = uploads on the "storage" named volume (storage/app/media).
# Set AWS_BUCKET to use S3-compatible object storage instead. Object keys are
# the paths under storage/app/media, so moving is a straight copy of
# media/* to the bucket root. The bucket stays private: the app only hands
# out signed, expiring links.
# [CHOOSE] Hetzner Object Storage (fsn1), path-style:
#   AWS_ENDPOINT=https://fsn1.your-objectstorage.com
#   AWS_DEFAULT_REGION=fsn1
#   AWS_USE_PATH_STYLE_ENDPOINT=true
# [GENERATE] the access key and secret in Hetzner's console; never commit them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=fsn1
AWS_BUCKET=
# Leave AWS_URL empty: links are signed against AWS_ENDPOINT.
AWS_URL=
AWS_ENDPOINT=https://fsn1.your-objectstorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true
# The longest queue job (collection ZIPs) runs up to 15 minutes; keep this above it.
DB_QUEUE_RETRY_AFTER=960

# --- Demo portfolio --------------------------------------------------------------
# [GENERATE] a free Unsplash developer access key, used only by
# "php artisan portfolio:demo-seed" to fetch the public demo's stock photos.
UNSPLASH_ACCESS_KEY=

# --- Mail ------------------------------------------------------------------------
# [CARRY OVER] SMTP settings from dev2
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
# [CARRY OVER] secret
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@ascend-digital.co.uk
MAIL_FROM_NAME=Portfol.io

# --- Stripe (subscriptions; the shared Ascend Digital account) ------------------
# [CARRY OVER] publishable key (pk_live_...)
STRIPE_KEY=
# [CARRY OVER] secret (sk_live_...)
STRIPE_SECRET=
# [GENERATE] secret: add a webhook endpoint for
# https://portfolio.ascend-digital.co.uk/stripe/webhook in Stripe and copy its whsec_...
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=10

# --- Stripe Connect (print and download sales; Portfolio's own Stripe account) ---
# Selling stays "coming soon" until the secret and webhook secret are both set.
# [GENERATE] in the new Portfolio Stripe account: Developers > API keys
PORTFOLIO_CONNECT_STRIPE_KEY=
PORTFOLIO_CONNECT_STRIPE_SECRET=
# [GENERATE] webhook endpoint https://portfolio.ascend-digital.co.uk/stripe/connect/webhook
# (events from "Your account" AND "Connected accounts"); copy its whsec_...
PORTFOLIO_CONNECT_STRIPE_WEBHOOK_SECRET=
PORTFOLIO_CONNECT_COUNTRY=GB

# --- Prodigi (print fulfilment) ---------------------------------------------------
# [CARRY OVER] secret
PRODIGI_API_KEY=
# [CARRY OVER]
# Not used by the v4 API (it authenticates with the API key alone).
PRODIGI_MERCHANT_ID=
# "live" or "sandbox"
PRODIGI_ENVIRONMENT=live

# --- Launch offer --------------------------------------------------------------------
# 50% off the first 3 months of monthly plans until the end date. The Stripe
# coupon is created by `php artisan stripe:sync-plans --apply`. Empty
# LAUNCH_COUPON_ID switches the offer off early.
LAUNCH_COUPON_ID=LAUNCH50
LAUNCH_OFFER_ENDS_AT=2027-02-10T23:59:59+00:00

# Custom domains (photographers' own domains, e.g. stephshoots.com)
# Bearer token for GET /internal/custom-domains (the server's Traefik sync job).
# Leave empty to disable the endpoint (404). Never commit the real value.
CUSTOM_DOMAINS_SYNC_TOKEN=
CUSTOM_DOMAINS_TARGET_IP=2.28.38.210
CUSTOM_DOMAINS_TARGET_IPV6=
CUSTOM_DOMAINS_CNAME_TARGETS=portfolio.ascend-digital.co.uk,custom.portfolio.ascend-digital.co.uk
# Plans that can add domains, and how many: slug:count,slug:count
CUSTOM_DOMAIN_PLANS=photographer:1,videographer:1
# Extra hostnames that are the platform itself (comma-separated), besides APP_URL's
CUSTOM_DOMAINS_PLATFORM_HOSTS=

# --- Support chat ------------------------------------------------------------------
# Public widget key (pk_...); empty hides the widget.
CHATMESH_KEY=
CHATMESH_URL=https://chatmesh.ascend-digital.co.uk

# Print sales: minimum price assumes these card fees; costs are quoted to this country.
PRINT_FALLBACK_RETAIL_PRICE=29.99
PRINT_STRIPE_FEE_PERCENT=2.5
PRINT_STRIPE_FEE_FIXED=0.20
PRINT_QUOTE_COUNTRY=GB
PRINT_QUOTE_CURRENCY=GBP
PRINT_SHIPPING_METHOD=Standard

# Platform CRM (Ascend Digital): reports accounts and revenue. Off while the token is empty.
PLATFORM_CRM_URL=https://crm.ascend-digital.co.uk
PLATFORM_CRM_TOKEN=

# Ascend Digital's own conversion tracking: loads only after cookie consent, and
# never on photographers' portfolios or custom domains. Empty = off.
GA4_MEASUREMENT_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_SIGNUP_LABEL=
GOOGLE_ADS_PURCHASE_LABEL=
META_PIXEL_ID=
